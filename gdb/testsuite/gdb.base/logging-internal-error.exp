# Check that the backtrace generated by "maint internal-error", if any, also
# ends up in the log file.

require {!isremote host}

# Do not run if gdb debug is enabled as it will interfere with logging.
require !gdb_debug_enabled

clean_restart

# Don't quit, don't produce a core file.
gdb_test_no_output "maint set internal-error corefile no"
gdb_test_no_output "maint set internal-error quit no"

set log_name [standard_output_file log.txt]
gdb_test_no_output "set logging file $log_name" \
    "set logging filename"
gdb_test_no_output "set logging overwrite on"
gdb_test "set logging enabled on" "Copying output to .*"

set seen_bt 0
set re_bt [string_to_regexp "----- Backtrace -----"]

set cmd "maint internal-error"
send_gdb "$cmd\n"
set re \
    [multi_line \
	 [string_to_regexp "Command aborted."] \
	 "$gdb_prompt $"]
gdb_expect {
    -re $re_bt {
	set seen_bt 1
	exp_continue
    }
    -re $re {
	pass $cmd
    }
    -re "$gdb_prompt $" {
	fail $cmd
    }
    timeout {
	fail "$cmd (timeout)"
    }
    eof {
	fail "$cmd (eof)"
    }
}

gdb_test "set logging enabled off" "Done logging to .*"

set fd [open $log_name]
set data [read -nonewline $fd]
close $fd

set test "Logged backtrace"
if {$seen_bt} {
    gdb_assert {[regexp $re_bt.*$hex $data]} $test
} else {
    unsupported $test
}
