standard_testfile .cc

if {[prepare_for_testing "failed to prepare" $testfile $srcfile {debug c++}]} {
    return
}

if {![runto_main]} {
    return
}

gdb_breakpoint [gdb_get_line_number "break-here"]
gdb_continue_to_breakpoint "break-here"

# Ambiguity between ::x and A::x.
set re_possibilities "(x and A::x|A::x and x)"
gdb_test "p x" \
    [subst_vars \
	 {Reference to "x" is ambiguous, possibilities are: $re_possibilities}]
